# Connection
MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=auto
BOT_USERNAME=AgentBot
MC_AUTH=offline

# Permissions & Chat
CMD_PREFIX=!
ADMINS=PlayerName1,PlayerName2
DEBUG_CHAT=false
LOG_LEVEL=info

# Automation
AUTO_EAT=true
AUTO_SLEEP=true
MIN_HUNGER=14
BED_RANGE=32

# Navigation & Timing
MOVEMENT_TIMEOUT=30
FOLLOW_DISTANCE=2
RECONNECT_DELAY=10
COMMAND_COOLDOWN=500

# MCP
# openssl rand -hex 32
MCP_TOKEN=123456aBcDeF...

# Telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_ALLOWED_CHAT_IDS=123456789
TELEGRAM_ALLOWED_USERNAMES=tuo_username
TELEGRAM_MIRROR_ALL=true
TELEGRAM_MIRROR_CONSOLE=true
TELEGRAM_MIRROR_LEVELS=chat,chat_out,whisper,warn,error,console
